<IfModule mod_rewrite.c>

    RewriteEngine On


    # Allow permission.php directly
    RewriteRule ^permission\.php$ - [L]


    # Do not redirect existing public requests
    RewriteCond %{REQUEST_URI} !^/public/


    # Redirect everything else to public
    RewriteRule ^(.*)$ public/$1 [L]

</IfModule>